{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576
    }
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Accounts": {
    "SignUpEnabled": false,
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "14.00:00:00",
    "RefreshTokenMaxLength": 4096,
    "EmailTokenLifetime": "1.00:00:00",
    "PasswordMinLength": 12,
    "LockoutMaxFailedAttempts": 10,
    "LockoutDuration": "00:05:00",
    "DefaultTimeZone": "Asia/Jakarta",
    "Google": {
      "ClientIds": [],
      "MetadataAddress": "https://accounts.google.com/.well-known/openid-configuration",
      "ClockSkew": "00:00:30",
      "ReauthenticationMaxAge": "00:05:00",
      "KeysAutomaticRefreshInterval": "12:00:00",
      "KeysRefreshInterval": "00:05:00",
      "HttpTimeout": "00:00:30"
    }
  },
  "Valkey": {
    "HealthCheckTimeout": "00:00:01"
  },
  "RateLimits": {
    "Credentials": { "TokenLimit": 5, "ReplenishmentPeriod": "00:01:00" },
    "User": { "TokenLimit": 300, "ReplenishmentPeriod": "00:01:00" },
    "Anonymous": { "TokenLimit": 60, "ReplenishmentPeriod": "00:01:00" },
    "Timeout": "00:00:00.250",
    "WarningInterval": "00:01:00"
  },
  "Outbox": {
    "PollInterval": "00:00:01",
    "BatchSize": 50,
    "MaxAttempts": 5
  },
  "ApiLimits": {
    "RequestTimeout": "00:00:10",
    "KnownProxies": []
  }
}
