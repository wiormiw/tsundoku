# Copy to deploy/.env (git ignores it) and fill in.
POSTGRES_PASSWORD=change-me
# The OpenID Connect issuer of your identity provider, for example https://login.example.com/realms/main
AUTH_AUTHORITY=
AUTH_AUDIENCE=tsundoku-api
# Optional: an OTLP collector (Grafana Alloy, the OpenTelemetry Collector, Aspire dashboard).
OTEL_EXPORTER_OTLP_ENDPOINT=
