# Copy to deploy/.env (git ignores it) and fill in.
POSTGRES_PASSWORD=change-me
# The address clients and email links use to reach the API (absolute URL), for example https://api.example.com
PUBLIC_BASE_URL=https://api.example.com
# Sign-up is closed unless this is true. It closes Google sign-in too.
SIGNUP_ENABLED=false
# Optional: an OTLP collector (Grafana Alloy, the OpenTelemetry Collector, Aspire dashboard).
OTEL_EXPORTER_OTLP_ENDPOINT=
