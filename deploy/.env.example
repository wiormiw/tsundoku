# Copy to deploy/.env (git ignores it) and fill in.
# The Postgres superuser (the owner that runs migrations). Postgres reads it only when it creates the volume: an existing volume
# keeps its old password (tsundoku, for volumes made before this variable existed), so put that one here. No ; or ' in it.
POSTGRES_PASSWORD=change-me
# The password of the tsundoku_api login that the API uses (not the owner, not BYPASSRLS).
APP_DB_PASSWORD=change-me
# The address clients and email links use to reach the API (absolute URL), for example https://api.example.com
PUBLIC_BASE_URL=http://localhost:4600
# Sign-up is closed unless this is true; set it true once to create your account, then back to false.
# It closes Google sign-in too. Outside Development the API refuses to start with it true until a real mailer exists (B9).
SIGNUP_ENABLED=false
# The Google OAuth client id the ID tokens are issued for; blank means Google sign-in is off.
GOOGLE_CLIENT_ID=
